rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "limamahmd16@gmail.com";
    }

    // Validate that a customer stock decrease is paired atomically with
    // a fresh reservation document for exactly the amount removed.
    function validInventoryDecrease(productId) {
      let reservationId = request.resource.data.get('lastInventoryReservationId', '');
      let reservation = getAfter(
        /databases/$(database)/documents/inventoryReservations/$(reservationId)
      ).data;

      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stock',
          'updatedAt',
          'lastInventoryReservationId'
        ])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.updatedAt == request.time
        && reservationId is string
        && reservation.orderId is string
        && reservation.productId == productId
        && reservation.customerUid == request.auth.uid
        && reservation.qty is int
        && reservation.qty == resource.data.stock - request.resource.data.stock
        && reservation.state == 'reserved'
        && reservation.createdAt == request.time;
    }

    function validReservationOrder(orderId, productId, qty) {
      let order = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return signedIn()
        && order.customerUid == request.auth.uid
        && order.status == 'new'
        && order.inventoryManaged == true
        && order.inventory is map
        && order.inventory.get(productId, 0) == qty;
    }

    function reservationProductMatches(productId, reservationId) {
      let product = getAfter(
        /databases/$(database)/documents/products/$(productId)
      ).data;

      return product.lastInventoryReservationId == reservationId;
    }

    // --------------------------------------------------
    // Public products / admin product management
    // --------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validInventoryDecrease(productId);
    }

    // Private product cost/supplier data
    match /product_private/{productId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // --------------------------------------------------
    // Customer accounts
    // --------------------------------------------------
    match /customerAccounts/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      allow create, update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'name',
            'phone',
            'city',
            'address',
            'updatedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 30
          && request.resource.data.city is string
          && request.resource.data.city.size() <= 100
          && request.resource.data.address is string
          && request.resource.data.address.size() <= 500
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
    }

    // --------------------------------------------------
    // Public store content, admin writes
    // --------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --------------------------------------------------
    // Orders
    // --------------------------------------------------
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'orderNo',
          'customerUid',
          'customerEmail',
          'customer',
          'items',
          'inventory',
          'inventoryManaged',
          'total',
          'payment',
          'paymentProofUrl',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNo',
          'customerUid',
          'customerEmail',
          'customer',
          'items',
          'inventory',
          'inventoryManaged',
          'total',
          'payment',
          'paymentProofUrl',
          'status',
          'createdAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.orderNo is string
        && request.resource.data.orderNo.size() >= 4
        && request.resource.data.orderNo.size() <= 30
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasAll([
          'name',
          'phone',
          'city',
          'address'
        ])
        && request.resource.data.customer.keys().hasOnly([
          'name',
          'phone',
          'city',
          'address'
        ])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() >= 2
        && request.resource.data.customer.name.size() <= 100
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() >= 5
        && request.resource.data.customer.phone.size() <= 30
        && request.resource.data.customer.city is string
        && request.resource.data.customer.city.size() <= 100
        && request.resource.data.customer.address is string
        && request.resource.data.customer.address.size() >= 2
        && request.resource.data.customer.address.size() <= 500
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 6
        && request.resource.data.inventory is map
        && request.resource.data.inventory.size() == request.resource.data.items.size()
        && request.resource.data.inventoryManaged == true
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total <= 100000000
        && request.resource.data.payment is string
        && request.resource.data.payment in ['cod', 'transfer']
        && request.resource.data.paymentProofUrl is string
        && request.resource.data.paymentProofUrl.size() <= 2000
        && (
          (
            request.resource.data.payment == 'cod'
            && request.resource.data.paymentProofUrl == ''
          )
          ||
          (
            request.resource.data.payment == 'transfer'
            && request.resource.data.paymentProofUrl.size() > 10
          )
        )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      // Admin sees all orders. Customers can only read their own orders.
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
        );

      // Only admin can change lifecycle/status after creation.
      allow update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // Inventory reservation ledger
    // --------------------------------------------------
    match /inventoryReservations/{reservationId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'orderId',
          'productId',
          'customerUid',
          'qty',
          'state',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderId',
          'productId',
          'customerUid',
          'qty',
          'state',
          'createdAt'
        ])
        && request.resource.data.orderId is string
        && request.resource.data.productId is string
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.qty is int
        && request.resource.data.qty > 0
        && request.resource.data.qty <= 1000
        && request.resource.data.state == 'reserved'
        && request.resource.data.createdAt == request.time
        && reservationId == request.resource.data.orderId + '_' + request.resource.data.productId
        && validReservationOrder(
          request.resource.data.orderId,
          request.resource.data.productId,
          request.resource.data.qty
        )
        && reservationProductMatches(
          request.resource.data.productId,
          reservationId
        );

      // Reservation ledger is internal. Customers only create their own
      // reservation atomically with the order; admin manages release/consume.
      allow read, update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // Minimal customer-safe order tracking
    // --------------------------------------------------
    match /orderTracking/{trackingId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'orderNo',
          'customerUid',
          'status',
          'estimatedDelivery',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNo',
          'customerUid',
          'status',
          'estimatedDelivery',
          'updatedAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.orderNo is string
        && request.resource.data.orderNo.size() >= 4
        && request.resource.data.orderNo.size() <= 30
        && request.resource.data.status == 'new'
        && request.resource.data.estimatedDelivery is string
        && request.resource.data.estimatedDelivery == ''
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/orders/$(trackingId)
        ).data.customerUid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/orders/$(trackingId)
        ).data.orderNo == request.resource.data.orderNo;

      // New orders are private to their owner. Legacy tracking docs without
      // customerUid remain get-only so old same-device tracking still works.
      allow get: if isAdmin()
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
        )
        || !resource.data.keys().hasAny(['customerUid']);

      allow list: if false;
      allow update, delete: if isAdmin();
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
